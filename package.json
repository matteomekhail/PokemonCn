{
  "name": "pokemoncn",
  "version": "0.0.1",
  "private": true,
  "description": "Pokemon-themed component registry, in the spirit of shadcn/ui.",
  "homepage": "https://pokemoncn.dev",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build build:worker",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "registry:build": "turbo run registry:build",
    "deploy": "turbo run deploy",
    "format": "prettier --write \"**/*.{ts,tsx,md,mdx,json}\"",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  }
}
